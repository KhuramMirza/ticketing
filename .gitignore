# =========================
# Dependencies
# =========================
# This single rule will ignore the node_modules folder inside auth, tickets, client, etc.
node_modules/
.pnp
.pnp.js

# =========================
# Environment Variables
# =========================
# Even though Kubernetes uses secrets, you must prevent accidental commits of local .env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =========================
# Build Outputs
# =========================
# Ignores the compiled TypeScript output and Next.js production builds
dist/
build/
.next/
out/

# =========================
# Logs
# =========================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# System & IDE Files
# =========================
.DS_Store
.vscode/
.idea/

# =========================
# Infrastructure / Skaffold
# =========================
# Skaffold generates a hidden cache folder that should not be tracked
.skaffold/
.prettierrc